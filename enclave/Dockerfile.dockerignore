# Deny everything, then allow exactly what enclave/Dockerfile copies. The
# Dockerfile's COPY lines are the real include list; this keeps the build
# context small and keeps anything else (mock code, local files) out of it.
*
!enclave/requirements.lock
!enclave/src/carapace_enclave/__init__.py
!enclave/src/carapace_enclave/py.typed
!enclave/src/carapace_enclave/egress/
!enclave/src/carapace_enclave/clock.py
!enclave/src/carapace_enclave/__main__.py
!enclave/src/carapace_enclave/broker.py
!enclave/src/carapace_enclave/dek_cache.py
!enclave/src/carapace_enclave/ratelimit.py
!enclave/src/carapace_enclave/receipts.py
!enclave/src/carapace_enclave/runtime.py
!enclave/src/carapace_enclave/server_client.py
!enclave/src/carapace_enclave/server.py
!enclave/src/carapace_enclave/tls.py
!enclave/src/carapace_enclave/secure_memory.py
!enclave/src/carapace_enclave/attestation/
!packages/crypto/src/carapace_crypto/
**/__pycache__
**/*.pyc
